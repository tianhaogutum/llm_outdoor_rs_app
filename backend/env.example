# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
# Every variable is optional; the defaults are shown. Real environment
# variables override backend/.env.

# ---------------------------------------------------------------------------
# Database configuration
# Defaults to sqlite+aiosqlite:///absolute/path/to/backend/data/app.db if unset.
# Uncomment and adjust the path below to override the location:
# DATABASE_URL=sqlite+aiosqlite:///Users/yourname/path/to/repo/backend/data/app.db

# Example when pointing to a different file:
# DATABASE_URL=sqlite+aiosqlite:///tmp/rec_lab.db

# ---------------------------------------------------------------------------
# LLM / embedding / ranking client (backend/app/llm, docs/LLM_CLIENT.md)
#
# Provider per capability:
#   LLM_PROVIDER    vertex (default) | openrouter | ollama | mock
#   EMBED_PROVIDER  vertex | openrouter | mock      (unset: same as LLM_PROVIDER; ollama -> mock)
#   RANK_PROVIDER   openrouter | vertex | mock      (unset: openrouter; mock when LLM_PROVIDER=mock)
# Tests and CI use LLM_PROVIDER=mock: no network, everything mock.
# LLM_PROVIDER=vertex
# EMBED_PROVIDER=
# RANK_PROVIDER=

# Vertex AI: Application Default Credentials (`gcloud auth application-default login`),
# no keys in this file.
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=europe-west4
# Generation-only location override (e.g. global for Gemini 3.x, which is not served in europe-west4):
# VERTEX_LLM_LOCATION=
# Ranking API location (Discovery Engine; needs discoveryengine.googleapis.com enabled):
# VERTEX_RANK_LOCATION=global
# VERTEX_LLM_MODEL=gemini-2.5-flash
# VERTEX_EMBED_MODEL=gemini-embedding-001
# VERTEX_RANK_MODEL=semantic-ranker-default@latest
# Texts per embedding request (Vertex rejects > 250; a ~18k-token cap per request is also applied):
# VERTEX_EMBED_BATCH_SIZE=250

# OpenRouter (secret; never printed, logged or cached)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_LLM_MODEL=google/gemini-2.5-flash
# OPENROUTER_EMBED_MODEL=google/gemini-embedding-001
# OPENROUTER_RANK_MODEL=cohere/rerank-v3.5
# OPENROUTER_EMBED_BATCH_SIZE=64

# Local Ollama (generation only; the original narrative path)
# OLLAMA_API_URL=http://127.0.0.1:11434/api/generate
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_TIMEOUT=120

# Thinking for vertex/openrouter generate calls: token budget, 0 = off (default), -1 = provider default
# LLM_THINKING_BUDGET=0

# Budget: hard stop on real USD spent by one client (one process / one evaluation run)
# LLM_BUDGET_USD_PER_RUN=5

# Cache: local writable cache (default <repo>/.cache/llm) plus read-only frozen layers
# (comma-separated, relative to the repo root or absolute). LLM_CACHE_ONLY=true replays
# from the cache and fails on a miss instead of calling a provider.
# LLM_CACHE_ENABLED=true
# LLM_CACHE_DIR=
# LLM_CACHE_FROZEN_DIRS=
# LLM_CACHE_ONLY=false

# Default embedding dimensionality (Matryoshka truncation; vectors are L2-normalised)
# EMBED_DIM=768

# Robustness
# LLM_MAX_CONCURRENCY=8
# LLM_MAX_RETRIES=5
# LLM_TIMEOUT_S=60
# LLM_SCHEMA_RETRIES=2

# ---------------------------------------------------------------------------
# Logging
# LOG_LEVEL=INFO
# LOG_ENABLE_FILE=true
# LOG_ENABLE_CONSOLE=true
# LOG_DETAILED_FORMAT=true
